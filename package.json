{
  "name": "m365-copilot-proxy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @m365-copilot/proxy dev",
    "build": "pnpm -r build",
    "proxy": "tsx scripts/profiles.ts start ato --foreground",
    "profiles": "tsx scripts/profiles.ts",
    "pi": "bash scripts/pi-local.sh",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && npx vitest run",
    "test:live": "pnpm build && M365_LIVE=1 npx vitest run"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  }
}
